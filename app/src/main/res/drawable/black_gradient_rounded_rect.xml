<?xml version="1.0" encoding="utf-8"?>
<!-- 0.5.17: the Back and Home bar and buttons: radius 20, a vertical gradient. 0.5.73: the tokens' glass, light from the top, with the hairline rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/look_pad"
        android:startColor="@color/look_glass_raised"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/look_rim" />
</shape>

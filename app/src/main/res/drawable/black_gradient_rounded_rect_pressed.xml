<?xml version="1.0" encoding="utf-8"?>
<!-- 0.5.17: a pressed landscape Back or Home button. 0.5.73: the glass lit, with the focus rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/look_glass_raised"
        android:startColor="@color/look_glass_hover"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/look_rim_focus" />
</shape>
